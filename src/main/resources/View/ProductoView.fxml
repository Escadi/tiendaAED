<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="820.0" prefWidth="1100.0" styleClass="backgroundColor" stylesheets="@../Styles/Colors.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Views.ProductosView">

    <children>
        <VBox fx:id="vboxMain" alignment="TOP_CENTER" style="-fx-padding: 20;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

            <HBox alignment="TOP_LEFT">
                <Button fx:id="btnAtras" mnemonicParsing="false" onAction="#atras" styleClass="btnClose" stylesheets="@../Styles/Buttons.css">
                    <graphic>
                        <ImageView fitHeight="50.0" fitWidth="26.0" preserveRatio="true">
                            <image>
                                <Image url="@../Images/FlechaIzquidaGibli.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>


            <ImageView fitHeight="222.0" fitWidth="535.0" preserveRatio="true">
                <image>
                    <Image url="@../Images/productosLogo2.png" />
                </image>
            </ImageView>


            <Line endX="822.0" startX="-127.5" />


            <HBox alignment="CENTER" spacing="10.0">
                <ImageView fitHeight="38.0" fitWidth="39.0" preserveRatio="true">
                    <image>
                        <Image url="@../Images/LupaGibli.png" />
                    </image>
                </ImageView>

                <TextField fx:id="TextBuscar" alignment="CENTER" prefHeight="38.0" prefWidth="300.0" promptText="Buscar Producto">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </TextField>
            </HBox>


            <TableView fx:id="TablaProductos" maxHeight="442.0" maxWidth="1002.0" minHeight="440.0" minWidth="1000.0" prefHeight="441.0" prefWidth="1002.0" styleClass="backgroundColorTableViews" stylesheets="@../Styles/Colors.css">
                <columns>
                    <TableColumn fx:id="ColidProducto" prefWidth="150.0" text="Nº Producto" />
                    <TableColumn fx:id="ColProducto" prefWidth="274.0" text="Nombre" />
                    <TableColumn fx:id="ColPrecio" prefWidth="182.0" text="Precio" />
                    <TableColumn fx:id="ColidCategoria" prefWidth="393.0" text="Categoría" />
                </columns>
            </TableView>


            <HBox fx:id="hboxMod" alignment="CENTER" spacing="10.0" visible="false">
                <Button fx:id="btnModificar" prefHeight="49.0" prefWidth="119.0" styleClass="btnSelection" stylesheets="@../Styles/Buttons.css" text="Editar">
                    <graphic>
                        <ImageView fitHeight="32.0" fitWidth="28.0" preserveRatio="true">
                            <image>
                                <Image url="@../Images/EditarGibli.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="btnEliminar" prefHeight="50.0" prefWidth="102.0" styleClass="btnSelection" stylesheets="@../Styles/Buttons.css" text="Eliminar">
                    <graphic>
                        <ImageView fitHeight="28.0" fitWidth="26.0" preserveRatio="true">
                            <image>
                                <Image url="@../Images/EliminarGibli.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
