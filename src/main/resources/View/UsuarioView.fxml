<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="820.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Views.UsuariosView">

    <children>
        <VBox fx:id="vboxMain" alignment="TOP_CENTER" spacing="30.0" style="-fx-padding: 20;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <HBox alignment="TOP_LEFT">
                <Button fx:id="btnAtras" mnemonicParsing="false" onAction="#atras" styleClass="btnClose" stylesheets="@../Styles/Buttons.css">
                    <graphic>
                        <ImageView fitHeight="50.0" fitWidth="26.0" preserveRatio="true">
                            <image>
                                <Image url="@../Images/FlechaIzquidaGibli.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>


            <ImageView fitHeight="159.0" fitWidth="403.0" preserveRatio="true">
                <image>
                    <Image url="@../Images/usuariosLogo2.png" />
                </image>
            </ImageView>


            <Line endX="822.0" startX="-127.5" />


            <HBox alignment="CENTER" spacing="10.0">
                <ImageView fitHeight="38.0" fitWidth="39.0" preserveRatio="true">
                    <image>
                        <Image url="@../Images/LupaGibli.png" />
                    </image>
                </ImageView>

                <TextField fx:id="TextBuscar" alignment="CENTER" prefHeight="38.0" prefWidth="300.0" promptText="Buscar Usuario">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </TextField>

                <Button fx:id="btnAgregar" onAction="#agregarUsuario" prefHeight="38.0" prefWidth="38.0" styleClass="btnSelection" stylesheets="@../Styles/Buttons.css">
                    <graphic>
                        <ImageView fitHeight="31.0" fitWidth="26.0" preserveRatio="true">
                            <image>
                                <Image url="@../Images/AgregarUsuarioGibli.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>


            <HBox fx:id="hboxMod" alignment="CENTER" spacing="10.0" visible="false">
                <Button fx:id="btnModificar" prefHeight="49.0" prefWidth="119.0" styleClass="btnSelection" stylesheets="@../Styles/Buttons.css" text="Editar">
                    <graphic>
                        <ImageView fitHeight="32.0" fitWidth="28.0" preserveRatio="true">
                            <image>
                                <Image url="@../Images/EditarGibli.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="btnEliminar" prefHeight="50.0" prefWidth="102.0" styleClass="btnSelection" stylesheets="@../Styles/Buttons.css" text="Eliminar">
                    <graphic>
                        <ImageView fitHeight="28.0" fitWidth="26.0" preserveRatio="true">
                            <image>
                                <Image url="@../Images/EliminarGibli.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
   
   
            <TableView fx:id="TablaUsuarios" maxHeight="503.0" maxWidth="1001.0" minHeight="502.0" minWidth="1000.0" styleClass="backgroundColorTableViews" stylesheets="@../Styles/Colors.css" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="ColidUsuario" prefWidth="129.0" text="Nº Usuario" />
                    <TableColumn fx:id="ColNombre" prefWidth="246.0" text="Nombre" />
                    <TableColumn fx:id="ColApellido" prefWidth="268.0" text="Apellido" />
                    <TableColumn fx:id="ColEmail" prefWidth="375.0" text="Email" />
                </columns>
            </TableView>
        </VBox>

        <VBox fx:id="vboxAgregar" prefHeight="434.0" prefWidth="273.0" styleClass="vboxUser" stylesheets="@../Styles/Vbox.css" visible="false">

            <Button fx:id="btnCerrar" onAction="#cerrarVentana" prefHeight="37.0" prefWidth="48.0" styleClass="btnClose" stylesheets="@../Styles/Buttons.css">
                <graphic>
                    <ImageView fitHeight="27.0" fitWidth="24.0" preserveRatio="true">
                        <image>
                            <Image url="@../Images/CerrarGibli.png" />
                        </image>
                    </ImageView>
                </graphic>
            <VBox.margin>
               <Insets bottom="-50.0" left="210.0" />
            </VBox.margin>
            </Button>

            <ImageView fitHeight="91.0" fitWidth="247.0" preserveRatio="true">
                <image>
                    <Image url="@../Images/usuariosLogo2.png" />
                </image>
            </ImageView>

            <Line endX="100.0" startX="-150.0" />

            <Label styleClass="textVbox" stylesheets="@../Styles/TextColors.css" text="Nº Usuario" />
            <TextField />

            <Label styleClass="textVbox" stylesheets="@../Styles/TextColors.css" text="Nombre" />
            <TextField />

            <Label styleClass="textVbox" stylesheets="@../Styles/TextColors.css" text="Apellido" />
            <TextField />

            <Label styleClass="textVbox" stylesheets="@../Styles/TextColors.css" text="Email" />
            <TextField />

            <Button alignment="CENTER" contentDisplay="CENTER" prefHeight="38.0" prefWidth="91.0" styleClass="btnSelection" stylesheets="@../Styles/Buttons.css" text="CONFIRMAR">
            <VBox.margin>
               <Insets left="80.0" top="10.0" />
            </VBox.margin></Button>
        </VBox>
    </children>
</AnchorPane>
