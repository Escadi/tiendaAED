<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="820.0" prefWidth="1100.0" styleClass="backgroundColor" stylesheets="@../Styles/Colors.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Views.PedidosView">

    <children>
        <VBox fx:id="vboxMain" alignment="TOP_CENTER" spacing="15.0" style="-fx-padding: 20;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="0.0">

            <HBox alignment="TOP_LEFT">
                <Button fx:id="btnAtras" mnemonicParsing="false" onAction="#atras" styleClass="btnClose" stylesheets="@../Styles/Buttons.css">
                    <graphic>
                        <ImageView fitHeight="50.0" fitWidth="26.0" preserveRatio="true">
                            <image>
                                <Image url="@../Images/FlechaIzquidaGibli.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>


            <ImageView fitHeight="222.0" fitWidth="535.0" preserveRatio="true">
                <image>
                    <Image url="@../Images/pedidosLogo2.png" />
                </image>
            </ImageView>


            <Line endX="822.0" startX="-127.5" />


            <HBox alignment="CENTER" spacing="10.0">
                <ImageView fitHeight="38.0" fitWidth="39.0" preserveRatio="true">
                    <image>
                        <Image url="@../Images/LupaGibli.png" />
                    </image>
                </ImageView>

                <TextField fx:id="TextBuscar" alignment="CENTER" prefHeight="38.0" prefWidth="300.0" promptText="Buscar Pedido">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </TextField>
            </HBox>
            <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
                <Button fx:id="btnExportXML" onAction="#exportXML" prefHeight="38.0" prefWidth="38.0" styleClass="btnSelection" stylesheets="@../Styles/Buttons.css">
                    <graphic>
                        <ImageView fitHeight="31.0" fitWidth="26.0" preserveRatio="true" scaleX="1.2" scaleY="1.2">
                            <image>
                                <Image url="@../Images/XMLGibli.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <VBox.margin>
                    <Insets left="950.0" />
                </VBox.margin>
            </HBox>

            <HBox fx:id="hboxBarraPedido" alignment="CENTER" spacing="10.0" visible="false">
                <Button fx:id="btnModificar" onAction="#modificarPedidosVista" prefHeight="49.0" prefWidth="119.0" styleClass="btnSelection" stylesheets="@../Styles/Buttons.css" text="Editar">
                    <graphic>
                        <ImageView fitHeight="32.0" fitWidth="28.0" preserveRatio="true">
                            <image>
                                <Image url="@../Images/EditarGibli.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="btnEliminar" onAction="#eliminarPedido" prefHeight="50.0" prefWidth="102.0" styleClass="btnSelection" stylesheets="@../Styles/Buttons.css" text="Eliminar">
                    <graphic>
                        <ImageView fitHeight="28.0" fitWidth="26.0" preserveRatio="true">
                            <image>
                                <Image url="@../Images/EliminarGibli.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>


            <TableView fx:id="tablaPedidos" maxHeight="503.0" maxWidth="1001.0" minHeight="502.0" minWidth="1000.0" styleClass="backgroundColorTableViews" stylesheets="@../Styles/Colors.css" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="ColidPedido" prefWidth="107.0" text="Nº Pedido" />
                    <TableColumn fx:id="ColidUsuario" prefWidth="170.0" text="Usuario" />
                    <TableColumn fx:id="ColidProducto" prefWidth="163.0" text="Producto" />
                    <TableColumn fx:id="ColCantidad" prefWidth="192.0" text="Cantidad" />
                    <TableColumn fx:id="ColFecha" prefWidth="386.0" text="Fecha Pedido" />
                </columns>
            </TableView>



        </VBox>

         <VBox fx:id="vboxModificarPedido" prefHeight="502.0" prefWidth="277.0" styleClass="vboxUser" stylesheets="@../Styles/Vbox.css" visible="false">

             <Button fx:id="btnCerrar" onAction="#cerrarVentana" prefHeight="37.0" prefWidth="48.0" styleClass="btnClose" stylesheets="@../Styles/Buttons.css">
                 <graphic>
                     <ImageView fitHeight="27.0" fitWidth="24.0" preserveRatio="true">
                         <image>
                             <Image url="@../Images/CerrarGibli.png" />
                         </image>
                     </ImageView>
                 </graphic>
                 <VBox.margin>
                     <Insets bottom="-50.0" left="210.0" />
                 </VBox.margin>
             </Button>

             <ImageView fitHeight="91.0" fitWidth="214.0" preserveRatio="true">
                 <image>
                     <Image url="@../Images/pedidosLogo2.png" />
                 </image>
             </ImageView>

             <Line endX="100.0" startX="-150.0" strokeWidth="3.0" />

             <Label styleClass="textVbox" stylesheets="@../Styles/TextColors.css" text="Nº Pedido" />
             <TextField fx:id="textFieldIdPedidoJoin" editable="false" styleClass="vboxTextField" stylesheets="@../Styles/Vbox.css" />

             <Label styleClass="textVbox" stylesheets="@../Styles/TextColors.css" text="Cliente" />
             <TextField fx:id="textFieldIdUsuarioJoin" />

             <Label styleClass="textVbox" stylesheets="@../Styles/TextColors.css" text="Producto" />
             <TextField fx:id="textFieldIdProductoJoin" />
         <Label layoutX="22.0" layoutY="248.0" styleClass="textVbox" stylesheets="@../Styles/TextColors.css" text="Cantidad" />
         <TextField fx:id="textFieldCantidadJoin" layoutX="22.0" layoutY="275.0" />
         <Label layoutX="22.0" layoutY="306.0" styleClass="textVbox" stylesheets="@../Styles/TextColors.css" text="Fecha Pedido" />
         <TextField fx:id="textFieldFechaJoin" editable="false" layoutX="22.0" layoutY="333.0" styleClass="vboxTextField" stylesheets="@../Styles/Vbox.css" />

             <Button fx:id="btnConfirmar" alignment="CENTER" contentDisplay="CENTER" onAction="#modificarPedido" prefHeight="38.0" prefWidth="91.0" styleClass="btnSelection" stylesheets="@../Styles/Buttons.css" text="MODIFICAR">
                 <VBox.margin>
                     <Insets left="80.0" top="10.0" />
                 </VBox.margin>
             </Button>
         </VBox>
    </children>
</AnchorPane>
